{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 3 offline append-only validation record",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "prospective-real-case-validation@1"
        },
        "synthetic": {
          "const": true
        },
        "accuracy_eligible": {
          "const": false
        },
        "commercial_release_hold": {
          "const": "ACTIVE"
        },
        "canonical_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "record_type": {
          "const": "validation_case"
        },
        "evidence_level": {
          "const": "L0"
        },
        "registered_at": {
          "type": "string",
          "format": "date-time"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "outcome_hidden_from_prediction": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "role": {
                "const": "independent"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "available_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "source_id",
              "role",
              "text",
              "available_at"
            ]
          }
        },
        "given_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "available_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "fact_id",
              "text",
              "available_at"
            ]
          }
        },
        "pilot_batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "case_role": {
          "enum": [
            "development",
            "pilot_evaluation",
            "holdout_evaluation"
          ]
        },
        "consent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "synthetic_not_applicable"
            },
            "analysis": {
              "const": false
            },
            "storage": {
              "const": false
            },
            "followup": {
              "const": false
            },
            "withdrawal_available": {
              "const": true
            }
          },
          "required": [
            "status",
            "analysis",
            "storage",
            "followup",
            "withdrawal_available"
          ]
        },
        "hidden_answer_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}$"
          }
        },
        "future_outcome_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}$"
          }
        },
        "visible_input_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "simulated_validation_track": {
          "enum": [
            "unverified",
            "retrospective_visible",
            "retrospective_blind",
            "prospective"
          ]
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "accuracy_eligible",
        "commercial_release_hold",
        "canonical_hash",
        "case_id",
        "record_type",
        "evidence_level",
        "registered_at",
        "question",
        "outcome_hidden_from_prediction",
        "sources",
        "given_facts",
        "pilot_batch_id",
        "case_role",
        "consent",
        "hidden_answer_fields",
        "future_outcome_fields",
        "visible_input_hash",
        "simulated_validation_track"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "prospective-real-case-validation@1"
        },
        "synthetic": {
          "const": true
        },
        "accuracy_eligible": {
          "const": false
        },
        "commercial_release_hold": {
          "const": "ACTIVE"
        },
        "canonical_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "record_type": {
          "const": "validation_prediction"
        },
        "prediction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence_level": {
          "const": "L0"
        },
        "prediction_snapshot": {
          "$ref": "#/$defs/predictionSnapshot"
        },
        "claim_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "claim_type": {
                "enum": [
                  "current_state",
                  "prior_event",
                  "future_event",
                  "timing",
                  "outcome",
                  "relationship_action",
                  "exam_result",
                  "fertility_stage",
                  "other"
                ]
              },
              "event_window": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "result_variable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "atomic": {
                "type": "boolean"
              },
              "outcome_criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "basis_source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "uniqueItems": true
              },
              "predicted_event_or_state": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "domain": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "validation_track": {
                "enum": [
                  "unverified",
                  "retrospective_visible",
                  "retrospective_blind",
                  "prospective"
                ]
              },
              "predicted_direction": {
                "enum": [
                  "support",
                  "contradict"
                ]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "specificity_level": {
                "enum": [
                  "bounded",
                  "vague"
                ]
              },
              "given_dependency_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "uniqueItems": true
              },
              "exclusion_conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "uniqueItems": true
              },
              "scorable": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "uniqueItems": true
              },
              "accuracy_eligible": {
                "const": false
              }
            },
            "required": [
              "claim_id",
              "claim_type",
              "event_window",
              "result_variable",
              "atomic",
              "outcome_criterion",
              "basis_source_ids",
              "predicted_event_or_state",
              "domain",
              "validation_track",
              "predicted_direction",
              "confidence",
              "specificity_level",
              "given_dependency_ids",
              "exclusion_conditions",
              "scorable",
              "reasons",
              "accuracy_eligible"
            ]
          }
        },
        "revision_of": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "simulated_validation_track": {
          "enum": [
            "unverified",
            "retrospective_visible",
            "retrospective_blind",
            "prospective"
          ]
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "accuracy_eligible",
        "commercial_release_hold",
        "canonical_hash",
        "case_id",
        "record_type",
        "prediction_id",
        "evidence_level",
        "prediction_snapshot",
        "claim_contracts",
        "revision_of",
        "simulated_validation_track"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
