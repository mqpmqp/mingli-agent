    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "prospective-real-case-validation@1"
        },
        "synthetic": {
          "const": true
        },
        "accuracy_eligible": {
          "const": false
        },
        "commercial_release_hold": {
          "const": "ACTIVE"
        },
        "canonical_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "record_type": {
          "const": "validation_adjudication"
        },
        "prediction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "adjudication_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outcome_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "hit",
            "partial",
            "miss",
            "unverifiable",
            "pending",
            "lost_to_followup",
            "refused",
            "missing"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "adjudicated_at": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "verdict": {
          "enum": [
            "hit",
            "partial",
            "miss",
            "unverifiable",
            "pending",
            "lost_to_followup",
            "refused",
            "missing"
          ]
        },
        "timing_verdict": {
          "enum": [
            "in_window",
            "out_of_window",
            "pending",
            "unverifiable"
          ]
        },
        "direction_verdict": {
          "enum": [
            "support",
            "contradict",
            "pending",
            "unverifiable"
          ]
        },
        "adjudicator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "adjudication_status": {
          "const": "single_reviewer"
        }
      },
      "required": [
        "schema_version",
        "synthetic",
        "accuracy_eligible",
        "commercial_release_hold",
