{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingli.local/schemas/promotion_source_check.schema.json",
  "title": "PromotionSourceCheck",
  "type": "object",
  "required": ["check_id", "candidate_id", "candidate_hash", "source_ids", "source_receipts", "source_family_count", "status", "reasons", "checked_at"],
  "properties": {
    "check_id": {"type": "string", "pattern": "^source-check:[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^candidate:[0-9a-f]{64}$"},
    "candidate_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^source:[0-9a-f]{64}$"}, "uniqueItems": true},
    "source_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "sha256", "source_family", "review_state"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^source:[0-9a-f]{64}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_family": {"type": "string", "minLength": 1},
          "review_state": {"enum": ["pending_human_review", "reviewed", "verified", "rejected"]}
        },
        "additionalProperties": false
      }
    },
    "source_family_count": {"type": "integer", "minimum": 0},
    "status": {"enum": ["passed", "failed"]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "checked_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
