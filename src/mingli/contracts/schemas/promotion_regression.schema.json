{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mingli.local/schemas/promotion_regression.schema.json",
  "title": "PromotionRegression",
  "type": "object",
  "required": ["regression_id", "candidate_id", "candidate_hash", "status", "total", "passed", "failed", "receipts", "limitations", "checked_at"],
  "properties": {
    "regression_id": {"type": "string", "pattern": "^regression:[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^candidate:[0-9a-f]{64}$"},
    "candidate_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["passed", "failed"]},
    "total": {"type": "integer", "minimum": 1},
    "passed": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "receipts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "checked_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
